{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pacelaps.com/schemas/procedure.schema.json",
  "title": "Procedure document",
  "description": "One JSON document used by the editor, the engine and the agent's offline copy. Unknown fields are rejected. Semantic checks (unique phase ids, reachable phases, goto/branch targets exist, failsafe-allowed blocks only, enabled commands only) are NOT expressible here and live in a validator next to the schema; see contracts/README.md (semantic procedure rules).",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "state",
    "phases"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    }
  },
  "$defs": {
    "trigger": {
      "type": "object",
      "required": [
        "on"
      ],
      "properties": {
        "on": {
          "enum": [
            "button",
            "telemetry",
            "timer",
            "failure"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "on": {
                "const": "button"
              }
            }
          },
          "then": {
            "required": [
              "label"
            ],
            "properties": {
              "on": {},
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "on": {
                "const": "telemetry"
              }
            }
          },
          "then": {
            "required": [
              "condition"
            ],
            "properties": {
              "on": {},
              "condition": {
                "$ref": "common.schema.json#/$defs/condition"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "on": {
                "const": "timer"
              }
            }
          },
          "then": {
            "required": [
              "seconds"
            ],
            "properties": {
              "on": {},
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "on": {
                "const": "failure"
              }
            }
          },
          "then": {
            "required": [
              "signal"
            ],
            "properties": {
              "on": {},
              "signal": {
                "enum": [
                  "no_active_agent",
                  "no_steward"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "required": [
        "id",
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/trigger"
          },
          "description": "Optional. Any one trigger starts the phase. The triggers of the first phase start the procedure. Triggers of a later phase are watched only while the procedure runs. A phase without triggers starts only through goto, branch or countdown cancel."
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "show_message",
            "announce",
            "iracing_command",
            "pits",
            "wait",
            "wait_steward",
            "wait_until",
            "open_sorting",
            "countdown",
            "branch",
            "goto",
            "end"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "show_message"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "text",
                  "affects"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "Banner text (message.schema.json text), at most 120 characters."
                  },
                  "affects": {
                    "$ref": "common.schema.json#/$defs/audience"
                  },
                  "visibleTo": {
                    "$ref": "common.schema.json#/$defs/audience"
                  },
                  "sticky": {
                    "type": "boolean"
                  },
                  "clears": {
                    "type": "boolean",
                    "description": "Withdraws every sticky banner this procedure run is still showing (for example the green flag after a caution). Without it, a sticky message replaces the run's earlier sticky banners of the same message type, and the run's end withdraws what is left."
                  },
                  "sound": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "flag",
                      "safety_car",
                      "penalty",
                      "wave_around",
                      "info",
                      "system"
                    ],
                    "description": "Message type. Default info."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "announce"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "iracing_command"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "command"
                ],
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "$ref": "command.schema.json#/properties/type"
                  },
                  "args": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pits"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "state"
                ],
                "additionalProperties": false,
                "properties": {
                  "state": {
                    "enum": [
                      "open",
                      "closed"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "seconds"
                ],
                "additionalProperties": false,
                "properties": {
                  "seconds": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait_steward"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait_until"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "condition"
                ],
                "additionalProperties": false,
                "properties": {
                  "condition": {
                    "$ref": "common.schema.json#/$defs/condition"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "open_sorting"
              }
            }
          },
          "then": {
            "properties": {
              "id": {},
              "type": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "countdown"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "seconds",
                  "cancelBy",
                  "onCancel"
                ],
                "additionalProperties": false,
                "properties": {
                  "seconds": {
                    "type": "number",
                    "minimum": 1
                  },
                  "cancelBy": {
                    "enum": [
                      "steward"
                    ]
                  },
                  "autoCancelWhen": {
                    "$ref": "common.schema.json#/$defs/condition"
                  },
                  "onCancel": {
                    "type": "string",
                    "description": "A phase id, or the word end."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "branch"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "condition",
                  "then",
                  "else"
                ],
                "additionalProperties": false,
                "properties": {
                  "condition": {
                    "$ref": "common.schema.json#/$defs/condition"
                  },
                  "then": {
                    "type": "string"
                  },
                  "else": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "goto"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "id": {},
              "type": {},
              "params": {
                "required": [
                  "phase"
                ],
                "additionalProperties": false,
                "properties": {
                  "phase": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "end"
              }
            }
          },
          "then": {
            "properties": {
              "id": {},
              "type": {}
            }
          }
        }
      ]
    }
  }
}
